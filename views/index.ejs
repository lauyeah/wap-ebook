<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đọc Truyện Online</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="theme-<%= theme %>">

  <div class="header-bar">
    <a href="/" class="btn">[Trang Chủ]</a>
    <% if (theme === 'dark') { %>
      <a href="?theme=light&q=<%= encodeURIComponent(query) %>&page=<%= currentPage %>" class="btn btn-secondary">[Chế độ Sáng]</a>
    <% } else { %>
      <a href="?theme=dark&q=<%= encodeURIComponent(query) %>&page=<%= currentPage %>" class="btn btn-dark-toggle">[Chế độ Tối]</a>
    <% } %>
  </div>

  <div class="search-box">
    <form action="/" method="GET">
      <input type="text" name="q" value="<%= query %>" placeholder="Tìm truyện..." class="input-text" style="width: 55%;">
      <input type="submit" value="Tìm" class="btn">
      <% if (query) { %>
        <a href="/" class="btn btn-secondary">[Xóa tìm]</a>
      <% } %>
    </form>
  </div>

  <hr>

  <h3>Danh sách truyện (Trang <%= currentPage %>/<%= totalPages %>)</h3>

  <% if (books.length === 0) { %>
    <p>Không tìm thấy truyện nào.</p>
  <% } else { %>
    <% books.forEach(function(book) { %>
      <div class="book-item">
        - <a href="/read/<%= book.id %>"><%= book.title %></a>
      </div>
    <% }); %>
  <% } %>

  <!-- Thanh phân trang & Nhảy trang -->
  <% if (totalPages > 1) { %>
    <div class="pagination">
      <% if (currentPage > 1) { %>
        <a href="/?q=<%= encodeURIComponent(query) %>&page=<%= currentPage - 1 %>" class="btn">&lt; Trước</a>
      <% } %>

      <span>[<%= currentPage %> / <%= totalPages %>]</span>

      <% if (currentPage < totalPages) { %>
        <a href="/?q=<%= encodeURIComponent(query) %>&page=<%= currentPage + 1 %>" class="btn">Sau &gt;</a>
      <% } %>

      <br>
      <!-- Chức năng Jump to page -->
      <form action="/" method="GET" class="jump-box">
        <input type="hidden" name="q" value="<%= query %>">
        <span>Đến trang:</span>
        <input type="number" name="page" min="1" max="<%= totalPages %>" value="<%= currentPage %>" class="jump-input" required>
        <button type="submit" class="btn" style="padding: 6px 12px; font-size: 18px;">Đi</button>
      </form>
    </div>
  <% } %>

</body>
</html>