<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đọc Truyện Online</title>
  <style>
    :root {
      --bg-color: #ffffff;
      --text-color: #222222;
      --card-bg: #f9f9f9;
      --border-color: #dddddd;
      --link-color: #1565c0;
      --btn-bg: #1e88e5;
      --btn-text: #ffffff;
      --title-color: #6a1b9a;
      --subtext: #666666;
    }

    [data-theme="dark"] {
      --bg-color: #121212;
      --text-color: #e0e0e0;
      --card-bg: #1e1e1e;
      --border-color: #2a2a2a;
      --link-color: #64b5f6;
      --btn-bg: #1e88e5;
      --btn-text: #ffffff;
      --title-color: #bb86fc;
      --subtext: #aaaaaa;
    }

    body { font-family: sans-serif; padding: 10px; margin: 0; background: var(--bg-color); color: var(--text-color); transition: background 0.3s, color 0.3s; }
    .header-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
    .btn { display: inline-block; padding: 6px 12px; background: var(--btn-bg); color: var(--btn-text); text-decoration: none; border-radius: 4px; font-weight: bold; }
    .theme-toggle { background: var(--card-bg); color: var(--text-color); border: 1px solid var(--border-color); padding: 6px 12px; border-radius: 4px; cursor: pointer; font-weight: bold; }
    
    /* Search Box Wrapper */
    .search-box { margin: 12px 0; }
    .search-input-container { position: relative; display: inline-block; width: 65%; max-width: 300px; }
    .search-input-container input[type="text"] { width: 100%; box-sizing: border-box; background: var(--card-bg); color: var(--text-color); border: 1px solid var(--border-color); padding: 7px 28px 7px 8px; border-radius: 4px; font-size: 15px; }
    .clear-search-btn { position: absolute; right: 6px; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--subtext); font-size: 16px; font-weight: bold; cursor: pointer; display: none; padding: 0 4px; }
    .clear-search-btn:hover { color: var(--text-color); }

    input[type="submit"] { background: var(--card-bg); color: var(--text-color); border: 1px solid var(--border-color); padding: 7px 12px; border-radius: 4px; cursor: pointer; font-weight: bold; }
    .book-item { padding: 10px 0; border-bottom: 1px solid var(--border-color); }
    .book-item a { color: var(--link-color); text-decoration: none; font-weight: bold; font-size: 17px; }
    .pagination { text-align: center; margin: 20px 0; }
    .pagination a { padding: 6px 12px; background: var(--btn-bg); color: var(--btn-text); text-decoration: none; border-radius: 4px; margin: 0 2px; font-weight: bold; }
    .jump-form { display: inline-block; margin-left: 8px; }
    .jump-input { width: 45px; padding: 5px; text-align: center; background: var(--card-bg); color: var(--text-color); border: 1px solid var(--border-color); border-radius: 4px; }
    hr { border: 0; border-top: 1px solid var(--border-color); }
  </style>
  <script>
    (function() {
      const savedTheme = localStorage.getItem('theme') || 'dark';
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();
  </script>
</head>
<body>

  <div class="header-bar">
    <a href="/" class="btn">[Trang Chủ]</a>
    <button class="theme-toggle" id="themeBtn" onclick="toggleTheme()">🌙 Tối</button>
  </div>

  <div class="search-box">
    <form action="/" method="GET" style="display: flex; gap: 6px; align-items: center;">
      <div class="search-input-container">
        <input type="text" id="searchInput" name="q" value="<%= query %>" placeholder="Tìm truyện..." oninput="toggleClearBtn()">
        <button type="button" id="clearBtn" class="clear-search-btn" onclick="clearSearch()">✕</button>
      </div>
      <input type="submit" value="Tìm kiếm">
    </form>
  </div>

  <hr>

  <h3 style="color: var(--title-color);">Danh sách truyện (Trang <%= currentPage %>/<%= totalPages %>)</h3>

  <% if (books.length === 0) { %>
    <p style="color: var(--subtext);">Không tìm thấy truyện nào.</p>
  <% } else { %>
    <% books.forEach(function(book) { %>
      <div class="book-item">
        • <a href="/read/<%= book.id %>"><%= book.title %></a>
      </div>
    <% }); %>
  <% } %>

  <% if (totalPages > 1) { %>
    <div class="pagination">
      <% if (currentPage > 1) { %>
        <a href="/?q=<%= encodeURIComponent(query) %>&page=<%= currentPage - 1 %>">❮ Trước</a>
      <% } %>

      <span style="color: var(--subtext);">[<%= currentPage %> / <%= totalPages %>]</span>

      <% if (currentPage < totalPages) { %>
        <a href="/?q=<%= encodeURIComponent(query) %>&page=<%= currentPage + 1 %>">Sau ❯</a>
      <% } %>

      <form action="/" method="GET" class="jump-form">
        <input type="hidden" name="q" value="<%= query %>">
        <input type="number" name="page" min="1" max="<%= totalPages %>" value="<%= currentPage %>" class="jump-input" required>
        <input type="submit" value="Đến">
      </form>
    </div>
  <% } %>

  <script>
    function updateBtnText(theme) {
      document.getElementById('themeBtn').innerText = theme === 'dark' ? '☀️ Sáng' : '🌙 Tối';
    }

    function toggleTheme() {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
      updateBtnText(newTheme);
    }

    // Xử lý nút xóa nhanh nội dung tìm kiếm
    function toggleClearBtn() {
      const input = document.getElementById('searchInput');
      const clearBtn = document.getElementById('clearBtn');
      clearBtn.style.display = input.value.length > 0 ? 'block' : 'none';
    }

    function clearSearch() {
      const input = document.getElementById('searchInput');
      input.value = '';
      toggleClearBtn();
      input.focus();
    }

    document.addEventListener('DOMContentLoaded', () => {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      updateBtnText(currentTheme);
      toggleClearBtn();
    });
  </script>

</body>
</html>