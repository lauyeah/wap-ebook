<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Trang <%= currentPage %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="theme-<%= theme %> reader-body">

  <div class="header-bar">
    <a href="/" class="btn">[Trang Chủ]</a>
    <% if (theme === 'dark') { %>
      <a href="?theme=light&page=<%= currentPage %>" class="btn btn-secondary">[Chế độ Sáng]</a>
    <% } else { %>
      <a href="?theme=dark&page=<%= currentPage %>" class="btn btn-dark-toggle">[Chế độ Tối]</a>
    <% } %>
  </div>

  <h2 class="title"><%= title %></h2>
  <div class="page-info">Trang <%= currentPage %> / <%= totalPages %></div>
  <hr>

  <div class="content"><%= text %></div>

  <hr>

  <!-- Thanh phân trang & Nhảy trang -->
  <div class="pagination">
    <% if (currentPage > 1) { %>
      <a href="/read/<%= bookId %>?page=<%= currentPage - 1 %>" class="btn">&lt; Trước</a>
    <% } %>

    <span>[<%= currentPage %> / <%= totalPages %>]</span>

    <% if (currentPage < totalPages) { %>
      <a href="/read/<%= bookId %>?page=<%= currentPage + 1 %>" class="btn">Sau &gt;</a>
    <% } %>

    <br>
    <!-- Chức năng Jump to page -->
    <form action="/read/<%= bookId %>" method="GET" class="jump-box">
      <span>Đến trang:</span>
      <input type="number" name="page" min="1" max="<%= totalPages %>" value="<%= currentPage %>" class="jump-input" required>
      <button type="submit" class="btn" style="padding: 6px 12px; font-size: 18px;">Đi</button>
    </form>
  </div>

  <div class="bottom-home">
    <a href="/" class="btn btn-large">[Về Trang Chủ]</a>
  </div>

</body>
</html>