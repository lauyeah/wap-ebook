<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Trang <%= currentPage %></title>
  <style>
    :root {
      --bg-color: #ffffff;
      --text-color: #222222;
      --card-bg: #f9f9f9;
      --border-color: #dddddd;
      --btn-bg: #1e88e5;
      --btn-text: #ffffff;
      --title-color: #6a1b9a;
      --subtext: #666666;
    }

    [data-theme="dark"] {
      --bg-color: #121212;
      --text-color: #e0e0e0;
      --card-bg: #1e1e1e;
      --border-color: #2a2a2a;
      --btn-bg: #1e88e5;
      --btn-text: #ffffff;
      --title-color: #bb86fc;
      --subtext: #aaaaaa;
    }

    body {
      font-family: Georgia, serif;
      padding: 12px;
      margin: 0;
      background: var(--bg-color);
      color: var(--text-color);
      line-height: 1.8;
      font-size: 18px;
      transition: background 0.3s, color 0.3s;
    }

    .header-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      font-family: sans-serif;
    }

    .btn {
      display: inline-block;
      padding: 6px 12px;
      background: var(--btn-bg);
      color: var(--btn-text);
      text-decoration: none;
      border-radius: 4px;
      font-weight: bold;
      font-size: 14px;
      font-family: sans-serif;
    }

    .theme-toggle {
      background: var(--card-bg);
      color: var(--text-color);
      border: 1px solid var(--border-color);
      padding: 6px 12px;
      border-radius: 4px;
      cursor: pointer;
      font-weight: bold;
      font-size: 14px;
    }

    .title {
      font-size: 22px;
      color: var(--title-color);
      margin: 10px 0 5px 0;
      font-family: sans-serif;
    }

    .page-info {
      font-size: 13px;
      color: var(--subtext);
      margin-bottom: 15px;
      font-family: sans-serif;
    }

    .content {
      white-space: pre-wrap;
      word-wrap: break-word;
      text-align: justify;
      margin-bottom: 20px;
    }

    .pagination {
      text-align: center;
      margin: 20px 0;
      font-family: sans-serif;
    }

    .pagination a {
      padding: 8px 14px;
      background: var(--btn-bg);
      color: var(--btn-text);
      text-decoration: none;
      border-radius: 4px;
      margin: 0 4px;
      font-weight: bold;
      font-size: 14px;
    }

    .jump-form {
      display: inline-block;
      margin-left: 8px;
    }

    .jump-input {
      width: 50px;
      padding: 6px;
      text-align: center;
      background: var(--card-bg);
      color: var(--text-color);
      border: 1px solid var(--border-color);
      border-radius: 4px;
      font-size: 14px;
    }

    input[type="submit"] {
      background: var(--card-bg);
      color: var(--text-color);
      border: 1px solid var(--border-color);
      padding: 6px 10px;
      border-radius: 4px;
      cursor: pointer;
      font-weight: bold;
      font-size: 14px;
    }

    .bottom-home-bar {
      text-align: center;
      margin-top: 15px;
      padding-top: 15px;
      border-top: 1px dashed var(--border-color);
      font-family: sans-serif;
    }

    hr {
      border: 0;
      border-top: 1px solid var(--border-color);
    }
  </style>
  <script>
    (function() {
      const savedTheme = localStorage.getItem('theme') || 'dark';
      document.documentElement.setAttribute('data-theme', savedTheme);
    })();
  </script>
</head>
<body>

  <!-- Thanh trên cùng -->
  <div class="header-bar">
    <a href="/" class="btn">🏠 Trang Chủ</a>
    <button class="theme-toggle" id="themeBtn" onclick="toggleTheme()">🌙 Tối</button>
  </div>

  <h2 class="title"><%= title %></h2>
  <div class="page-info">Trang <%= currentPage %> / <%= totalPages %></div>
  <hr>

  <!-- Nội dung truyện -->
  <div class="content"><%= text %></div>

  <hr>

  <!-- Phân trang -->
  <div class="pagination">
    <% if (currentPage > 1) { %>
      <a href="/read/<%= bookId %>?page=<%= currentPage - 1 %>">❮ Trước</a>
    <% } %>

    <span style="color: var(--subtext);">[<%= currentPage %> / <%= totalPages %>]</span>

    <% if (currentPage < totalPages) { %>
      <a href="/read/<%= bookId %>?page=<%= currentPage + 1 %>">Sau ❯</a>
    <% } %>

    <form action="/read/<%= bookId %>" method="GET" class="jump-form">
      <input type="number" name="page" min="1" max="<%= totalPages %>" value="<%= currentPage %>" class="jump-input" required>
      <input type="submit" value="Đến">
    </form>
  </div>

  <!-- Nút Trang Chủ ở cuối trang -->
  <div class="bottom-home-bar">
    <a href="/" class="btn" style="padding: 10px 20px; font-size: 15px;">🏠 Về Trang Chủ</a>
  </div>

  <script>
    function updateBtnText(theme) {
      document.getElementById('themeBtn').innerText = theme === 'dark' ? '☀️ Sáng' : '🌙 Tối';
    }

    function toggleTheme() {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
      updateBtnText(newTheme);
    }

    document.addEventListener('DOMContentLoaded', () => {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      updateBtnText(currentTheme);
    });
  </script>

</body>
</html>