<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quản Trị Hệ Thống</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="theme-<%= theme %>">

  <div class="header-bar">
    <a href="/" class="btn">[Về Trang Chủ]</a>
    <% if (theme === 'dark') { %>
      <a href="?theme=light" class="btn btn-secondary">[Chế độ Sáng]</a>
    <% } else { %>
      <a href="?theme=dark" class="btn btn-dark-toggle">[Chế độ Tối]</a>
    <% } %>
  </div>

  <h2>Quản Trị Hệ Thống</h2>

  <% if (message) { %>
    <div class="msg <%= success ? 'success' : 'error' %>">
      <%= message %>
    </div>
  <% } %>

  <!-- CHỨC NĂNG 1: THÊM TRUYỆN MỚI -->
  <button class="collapsible">1. Thêm Truyện Mới</button>
  <div class="collapsible-content card">
    <form action="/admin/upload" method="POST" enctype="multipart/form-data">
      <div class="form-group">
        <label>Mật khẩu Admin:</label>
        <input type="password" name="adminPassword" required>
      </div>

      <div class="form-group">
        <label>Tên truyện hiển thị:</label>
        <input type="text" name="displayTitle" placeholder="Ví dụ: Đắc Nhân Tâm" required>
      </div>

      <div class="form-group">
        <label>Chọn file (.txt):</label>
        <input type="file" name="file" accept=".txt" required>
      </div>

      <div class="form-group">
        <input type="submit" value="Tải lên" class="btn btn-full">
      </div>
    </form>
  </div>

  <!-- CHỨC NĂNG 2: DANH SÁCH & THAO TÁC TRUYỆN -->
  <button class="collapsible">2. Quản Lý Danh Sách Truyện (<%= typeof totalBooks !== 'undefined' ? totalBooks : 0 %>)</button>
  <div class="collapsible-content card" style="display: block;">
    <% if (typeof books === 'undefined' || books.length === 0) { %>
      <p>Chưa có truyện nào.</p>
    <% } else { %>
      
      <!-- FORM XÓA TRUYỆN -->
      <form id="deleteForm" action="/admin/delete-multiple" method="POST">
        <div style="margin-bottom: 15px; display: flex; align-items: center; gap: 10px;">
          <input type="password" name="adminPassword" id="deleteAdminPassword" placeholder="MK Admin để xóa" style="width: 180px; font-size: 18px;" required>
          <button type="button" class="btn btn-danger" onclick="executeDelete()">Xóa các mục đã chọn</button>
        </div>

        <table>
          <thead>
            <tr>
              <th style="width: 30px;">
                <input type="checkbox" class="checkbox-large" onclick="var c=document.querySelectorAll('.cb');for(var i=0;i<c.length;i++)c[i].checked=this.checked;">
              </th>
              <th>Tên Truyện</th>
              <th>Mã (Slug)</th>
              <th style="width: 90px; text-align: center;">Hành động</th>
            </tr>
          </thead>
          <tbody>
            <% books.forEach(function(book) { %>
              <!-- Hàng hiển thị thông tin -->
              <tr>
                <td>
                  <input type="checkbox" name="bookIds" value="<%= book.id %>" class="cb checkbox-large">
                </td>
                <td><strong><%= book.title %></strong></td>
                <td><code><%= book.id %></code></td>
                <td style="text-align: center;">
                  <button type="button" class="btn btn-warning" style="padding: 4px 10px; font-size: 16px;" onclick="toggleEditRow('<%= book.id %>')">Sửa</button>
                </td>
              </tr>

              <!-- Hàng ẩn để SỬA thông tin -->
              <tr id="edit-row-<%= book.id %>" style="display: none; background: rgba(255, 255, 255, 0.05);">
                <td colspan="4" style="padding: 12px 15px;">
                  <div style="font-weight: bold; margin-bottom: 8px; color: #f57c00;">[ Chỉnh sửa: <%= book.title %> ]</div>
                  
                  <div style="margin-bottom: 8px;">
                    <label style="font-size: 16px; margin-bottom: 2px;">Tên hiển thị mới:</label>
                    <input type="text" id="title-<%= book.id %>" value="<%= book.title %>" style="width: 95%; font-size: 18px; padding: 6px;">
                  </div>

                  <div style="margin-bottom: 8px;">
                    <label style="font-size: 16px; margin-bottom: 2px;">Mã (Slug) mới (để trống nếu giữ nguyên):</label>
                    <input type="text" id="slug-<%= book.id %>" value="<%= book.id %>" style="width: 95%; font-size: 18px; padding: 6px;">
                  </div>

                  <div style="margin-bottom: 8px;">
                    <label style="font-size: 16px; margin-bottom: 2px;">Mật khẩu Admin:</label>
                    <input type="password" id="pass-<%= book.id %>" placeholder="Nhập MK Admin để lưu" style="width: 95%; font-size: 18px; padding: 6px;">
                  </div>

                  <div style="margin-top: 10px;">
                    <button type="button" class="btn btn-warning" style="font-size: 16px; padding: 6px 14px;" onclick="submitUpdate('<%= book.id %>')">Lưu cập nhật</button>
                    <button type="button" class="btn btn-secondary" style="font-size: 16px; padding: 6px 14px;" onclick="toggleEditRow('<%= book.id %>')">Hủy</button>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </form>

      <!-- Form ẩn phục vụ Cập nhật truyện -->
      <form id="hiddenUpdateForm" action="/admin/update" method="POST" style="display: none;">
        <input type="hidden" name="oldBookId" id="formOldBookId">
        <input type="hidden" name="newDisplayTitle" id="formNewDisplayTitle">
        <input type="hidden" name="newBookId" id="formNewBookId">
        <input type="hidden" name="adminPassword" id="formAdminPassword">
      </form>

      <!-- Phân trang -->
      <% if (totalPages > 1) { %>
        <div class="pagination">
          <% if (currentPage > 1) { %>
            <a href="/admin?page=<%= currentPage - 1 %>" class="btn">&lt; Trước</a>
          <% } %>

          <span>[Trang <%= currentPage %> / <%= totalPages %>]</span>

          <% if (currentPage < totalPages) { %>
            <a href="/admin?page=<%= currentPage + 1 %>" class="btn">Sau &gt;</a>
          <% } %>

          <br>
          <form action="/admin" method="GET" class="jump-box">
            <span>Đến trang:</span>
            <input type="number" name="page" min="1" max="<%= totalPages %>" value="<%= currentPage %>" class="jump-input" required>
            <button type="submit" class="btn" style="padding: 6px 12px; font-size: 18px;">Đi</button>
          </form>
        </div>
      <% } %>
    <% } %>
  </div>

  <script>
    // Accordion Đóng/Mở
    var coll = document.getElementsByClassName("collapsible");
    for (var i = 0; i < coll.length; i++) {
      coll[i].addEventListener("click", function() {
        this.classList.toggle("active");
        var content = this.nextElementSibling;
        if (content.style.display === "block") {
          content.style.display = "none";
        } else {
          content.style.display = "block";
        }
      });
    }

    // Xử lý Xóa bằng JavaScript trực tiếp
    function executeDelete() {
      var password = document.getElementById("deleteAdminPassword").value;
      if (!password) {
        alert("Vui lòng nhập Mật khẩu Admin để xóa!");
        return;
      }

      var checkboxes = document.querySelectorAll('.cb:checked');
      if (checkboxes.length === 0) {
        alert("Vui lòng tích chọn ít nhất 1 truyện để xóa!");
        return;
      }

      if (confirm("Xác nhận xóa " + checkboxes.length + " truyện đã chọn?")) {
        document.getElementById("deleteForm").submit();
      }
    }

    // Toggle hiển thị form sửa
    function toggleEditRow(bookId) {
      var row = document.getElementById("edit-row-" + bookId);
      if (row.style.display === "none" || row.style.display === "") {
        row.style.display = "table-row";
      } else {
        row.style.display = "none";
      }
    }

    // Submit form sửa
    function submitUpdate(bookId) {
      var newTitle = document.getElementById("title-" + bookId).value;
      var newSlug = document.getElementById("slug-" + bookId).value;
      var password = document.getElementById("pass-" + bookId).value;

      if (!newTitle) {
        alert("Vui lòng nhập Tên hiển thị mới!");
        return;
      }
      if (!password) {
        alert("Vui lòng nhập Mật khẩu Admin!");
        return;
      }

      document.getElementById("formOldBookId").value = bookId;
      document.getElementById("formNewDisplayTitle").value = newTitle;
      document.getElementById("formNewBookId").value = newSlug;
      document.getElementById("formAdminPassword").value = password;

      document.getElementById("hiddenUpdateForm").submit();
    }
  </script>

</body>
</html>